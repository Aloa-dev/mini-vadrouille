# Copier ce fichier en ".env" puis renseigner les valeurs depuis le tableau de bord Supabase.
# Ne jamais publier le fichier .env (il est ignoré par Git).
# Seules des clés PUBLIQUES (publishable) vont ici. Aucune clé secrète (Stripe sk_..., service_role) dans ce projet.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
